[Unit]
Description=Mine Edge Agent (read-only acquisition)
Documentation=file:/opt/mine-edge-agent/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mine-edge
Group=mine-edge
WorkingDirectory=/var/lib/mine-edge-agent
EnvironmentFile=/etc/mine-edge-agent/mine-edge-agent.env
ExecStart=/opt/mine-edge-agent/venv/bin/mine-edge-agent serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

# Defense in depth: the service does not need or expose equipment control.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mine-edge-agent
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

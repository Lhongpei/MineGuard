# 节点身份（投产必须改为主管部门分配的固定编码）
MINE_EDGE_MINE_ID=QY-MINE-001
MINE_EDGE_CLIENT_ID=QY-MINE-001-EDGE-01

# 本地服务与持久化
MINE_EDGE_DB=./data/mine-edge.sqlite3
MINE_EDGE_HOST=127.0.0.1
MINE_EDGE_PORT=8091
MINE_EDGE_LOCAL_TIMEZONE=+08:00
# 监听 0.0.0.0 时必须配置；使用足够长的随机值
MINE_EDGE_API_TOKEN=

# 监管接收端 origin：只允许 HTTPS 协议、主机、可选端口，不得带路径/query/账号
# 程序固定追加 /v1/edge-telemetry-batches；仅本机回环联调可使用 HTTP
MINE_EDGE_UPSTREAM_URL=
# 与平台 MINEGUARD_EDGE_CLIENTS_JSON 中 secrets 项使用同一 base64 值
MINE_EDGE_UPSTREAM_HMAC_SECRET_BASE64=
MINE_EDGE_FORWARD_BATCH_SIZE=100
MINE_EDGE_FORWARD_BASE_DELAY_SECONDS=5
MINE_EDGE_FORWARD_MAX_DELAY_SECONDS=3600
MINE_EDGE_REQUEST_TIMEOUT_SECONDS=10

# 多源连续只读采集。token_env 只写环境变量名，密钥另行配置。
# methane_adaptive_sampling 只缩短读取周期，不向设备写入；窗口最长 3600 秒。
MINE_EDGE_SOURCES_JSON='[{"source_id":"gas-jsonl","adapter":"jsonl","path":"/data/mine-edge/gas.jsonl","interval_seconds":10,"jitter_seconds":2,"timeout_seconds":3,"missing_after_seconds":60,"enabled":true,"methane_adaptive_sampling":{"enabled":true,"trigger_ratio":0.8,"accelerated_interval_seconds":2,"window_seconds":300}},{"source_id":"safety-api","adapter":"http-poll","url":"https://gateway.example/read-only/observations","interval_seconds":15,"jitter_seconds":3,"timeout_seconds":5,"missing_after_seconds":90,"enabled":true,"token_env":"MINE_SOURCE_SAFETY_TOKEN","ca_file":"/etc/ssl/certs/enterprise-ca.pem"},{"source_id":"shift-drop","adapter":"file-drop","path":"/data/mine-edge/drop","interval_seconds":30,"jitter_seconds":5,"timeout_seconds":10,"missing_after_seconds":300,"enabled":false}]'
MINE_SOURCE_SAFETY_TOKEN=

# 以下仅为联调示例。按矿井和适用规程审核后，再改为 true。
MINE_EDGE_THRESHOLDS_CALIBRATED=false
MINE_EDGE_THRESHOLDS_JSON='{"methane_percent":{"blue":0.5,"yellow":0.8,"orange":1.0,"red":1.5},"personnel_capacity":{"underground":200,"face-101":40},"personnel_ratio":{"blue":0.8,"yellow":0.9,"orange":1.0,"red":1.1},"airflow_minimum":{"main-shaft":120.0,"face-101":18.0},"airflow_ratio":{"blue":0.95,"yellow":0.9,"orange":0.8,"red":0.7}}'
MINE_EDGE_RULE_PROFILE_ID=qinyuan-safety-default
MINE_EDGE_RULE_PROFILE_VERSION=1
# 可留空，由本地阈值规范 JSON 自动计算
MINE_EDGE_RULE_PROFILE_SHA256=

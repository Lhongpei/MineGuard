# Install as /etc/enterprise-agent/enterprise-agent.env, owner
# root:enterprise-agent, mode 0640. Keep JSON values on one physical line.

ENTERPRISE_AGENT_DB=/var/lib/enterprise-agent/enterprise-agent.db
ENTERPRISE_AGENT_SESSION_TTL_SECONDS=28800
ENTERPRISE_AGENT_ALLOW_ANONYMOUS_LOCAL=false
ENTERPRISE_AGENT_SECURE_COOKIE=true
ENTERPRISE_AGENT_PUBLIC_ORIGIN=https://report.enterprise.example
ENTERPRISE_AGENT_PRODUCTION_MODE=true
ENTERPRISE_AGENT_FOUR_EYES_REQUIRED=true

# Generate twice with `enterprise-agent hash-password --production --json`.
# Each output contains password_hash + credential_provenance and no plaintext.
ENTERPRISE_AGENT_USERS_JSON='[{"actor_id":"replace-preparer-id","name":"replace-preparer-name","role":"企业经办人","password_hash":"replace-with-production-hash","permissions":["read","write"],"must_change_password":false,"credential_provenance":"production_hash_command"},{"actor_id":"replace-reviewer-id","name":"replace-reviewer-name","role":"企业复核负责人","password_hash":"replace-with-different-production-hash","permissions":["read","confirm","submit"],"must_change_password":false,"credential_provenance":"production_hash_command"}]'

# One mine, one independently deployed Agent instance.
ENTERPRISE_MINE_ID=replace-mine-id
ENTERPRISE_MINE_NAME=replace-mine-name
ENTERPRISE_OPERATOR_ID=replace-independent-operator-id
ENTERPRISE_OPERATOR_NAME=replace-operator-name
ENTERPRISE_SYSTEM_ID=replace-registered-agent-system-id
ENTERPRISE_REPORTING_TIMEZONE=Asia/Shanghai
ENTERPRISE_CAPACITY_BAND=replace-governed-band
ENTERPRISE_MINING_METHOD=replace-governed-method
ENTERPRISE_SHIFT_SYSTEM=three-shift-eight-hour
ENTERPRISE_COAL_TYPE=replace-governed-coal-type
ENTERPRISE_OPERATING_REGIME=normal-production

# Optional controlled device/export inbox. Quarantine is always stored under
# /var/lib/enterprise-agent/five-quantity-quarantine, never in this source path.
# ENTERPRISE_FIVE_QUANTITY_WATCH_DIRS=/srv/mine-readonly/five-quantity-inbox
ENTERPRISE_FIVE_QUANTITY_POLL_SECONDS=5
ENTERPRISE_FIVE_QUANTITY_STABLE_SECONDS=2

# Optional companion connector process. One-mine mode accepts at most one
# authoritative client; its allowlist binds source_id exactly to source_system.
# The machine principal may only update an unconfirmed review draft.
# 正式环境必须显式声明 required 和 freshness_max_seconds，并与 connector TOML 一致。
# ENTERPRISE_AGENT_CONNECTOR_CLIENTS_JSON='[{"client_id":"replace-connector-client","secret":"replace-through-secret-manager-connector-key","permissions":["autofill"],"allowed_sources":{"replace-source-id":{"source_system":"replace-source-system","required":true,"freshness_max_seconds":3600}}}]'
ENTERPRISE_AGENT_CONNECTOR_MAX_CLOCK_SKEW_SECONDS=300

# Ten-quantity V3 transport. PLATFORM_V3_SENDER_ID must equal ENTERPRISE_SYSTEM_ID.
PLATFORM_V3_BASE_URL=https://replace-with-regulator-host.example
PLATFORM_V3_SENDER_ID=replace-registered-agent-system-id
PLATFORM_V3_TIMEOUT_SECONDS=20
REGULATORY_SYSTEM_ID=mineguard-qinyuan
REGULATORY_PARTY_ID=regulator-qinyuan
ENTERPRISE_EXCHANGE_KEY_ID=replace-enterprise-key-id
REGULATORY_EXCHANGE_KEY_ID=replace-regulator-key-id
ENTERPRISE_EXCHANGE_HMAC_SECRET=replace-through-secret-manager-message-key
PLATFORM_V3_TRANSPORT_HMAC_SECRET=replace-through-secret-manager-transport-key
# PLATFORM_V3_CA_BUNDLE=/etc/enterprise-agent/regulatory-ca.pem

# Temporary inbound verification overlap during an approved key rotation.
# REGULATORY_PREVIOUS_EXCHANGE_KEY_ID=replace-previous-regulator-key-id
# REGULATORY_PREVIOUS_EXCHANGE_HMAC_SECRET=replace-previous-message-key

# Optional, not required by the ten-quantity submission workflow.
# DEEPSEEK_API_KEY=replace-through-secret-manager
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=replace-with-approved-model

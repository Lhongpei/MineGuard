# Copy to /etc/enterprise-agent/enterprise-agent.env, set owner root:enterprise-agent
# and mode 0640. Keep every JSON value on one physical line.

# Use an absolute path so WorkingDirectory changes cannot select another database.
ENTERPRISE_AGENT_DB=/var/lib/enterprise-agent/enterprise-agent.db
ENTERPRISE_AGENT_SESSION_TTL_SECONDS=28800
ENTERPRISE_AGENT_ALLOW_ANONYMOUS_LOCAL=false

# The browser-facing reverse proxy must use HTTPS when this is true.
ENTERPRISE_AGENT_SECURE_COOKIE=true
# Exact browser origin. It has no path/query/fragment and must match the
# reverse proxy's preserved Host authority exactly.
ENTERPRISE_AGENT_PUBLIC_ORIGIN=https://report.enterprise.example

# Durable read-only coal health workflows. Disable only the scheduler when
# operators should retain manual runs but no timed/event-triggered execution.
AGENT_V2_ENABLED=true
AGENT_V2_SCHEDULER_ENABLED=true
AGENT_V2_SCHEDULER_POLL_SECONDS=5
AGENT_V2_WORKER_COUNT=2
AGENT_V2_SPECIALIST_WORKER_COUNT=4
AGENT_V2_FLOW_LEASE_SECONDS=120

# Generate password_hash interactively with:
# /opt/enterprise-agent/agent/.venv/bin/enterprise-agent hash-password
# Replace every example value. Never put a plaintext password in this file.
ENTERPRISE_AGENT_USERS_JSON='[{"actor_id":"replace-operator-id","name":"replace-name","role":"企业管理员","password_hash":"replace-with-generated-pbkdf2-hash","permissions":["read","write","confirm","submit","governance_review","skill_admin"],"must_change_password":false}]'

# These three values are issued/registered independently by the regulator.
# Production platform URLs must use HTTPS. The transport secret is not a source
# observation key and must contain at least 32 bytes of high-entropy material.
PLATFORM_BASE_URL=https://replace-with-regulator-host.example
PLATFORM_CLIENT_ID=replace-with-platform-issued-client-id
PLATFORM_TRANSPORT_HMAC_SECRET=replace-with-at-least-32-random-bytes
PLATFORM_SUBMISSION_PATH=/v1/enterprise-submissions
PLATFORM_CAPABILITIES_PATH=/v1/enterprise-submission-capabilities
PLATFORM_TIMEOUT_SECONDS=20

# Optional model assistance. Leave DEEPSEEK_API_KEY absent for deterministic
# rules-only operation. If enabled, inject the key with the deployment's secret
# manager instead of committing it here.
# DEEPSEEK_API_KEY=replace-through-secret-manager
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=replace-with-approved-model
# DEEPSEEK_TIMEOUT_SECONDS=20
# DEEPSEEK_MAX_RETRIES=2

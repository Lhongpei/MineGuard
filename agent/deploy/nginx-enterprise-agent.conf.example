# This file is intended for a conf.d directory inside Nginx's `http` context.
# The edge proxy must see the real client address for this zone to be useful.
limit_req_zone $binary_remote_addr
    zone=enterprise_agent_login:10m
    rate=3r/m;
limit_req_zone $binary_remote_addr
    zone=enterprise_agent_machine:10m
    rate=120r/m;
limit_conn_zone $binary_remote_addr zone=enterprise_agent_machine_conn:10m;
log_format enterprise_agent_safe
    '$remote_addr - $time_iso8601 '
    '"$request_method $uri $server_protocol" $status $body_bytes_sent '
    'request_time=$request_time';

server {
    listen 443 ssl;
    server_name report.enterprise.example;

    ssl_certificate     /etc/pki/enterprise-agent/fullchain.pem;
    ssl_certificate_key /etc/pki/enterprise-agent/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log /var/log/nginx/enterprise-agent.access.log enterprise_agent_safe;

    # A 20 MiB source file expands to roughly 27 MiB as base64 JSON.
    client_max_body_size 32m;
    client_body_timeout 30s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 120s;
    proxy_request_buffering on;
    proxy_hide_header Server;

    # Must exactly match ENTERPRISE_AGENT_PUBLIC_ORIGIN's authority.
    proxy_set_header Host report.enterprise.example;

    # Useful to the proxy/access log. The application deliberately does not
    # trust X-Forwarded-* for its Host or Origin security decisions.
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";

    # Login and the authenticated connector use separate budgets. Normal browser
    # operations do not consume either budget.
    location = /api/v1/auth/login {
        limit_req zone=enterprise_agent_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/v1/machine/autofill {
        # The application independently accepts at most a 2 MiB source string;
        # JSON escaping can enlarge the signed envelope, so the proxy cap is 5 MiB.
        client_max_body_size 5m;
        client_body_timeout 15s;
        limit_req zone=enterprise_agent_machine burst=30 nodelay;
        limit_req_status 429;
        limit_conn enterprise_agent_machine_conn 4;
        limit_conn_status 429;
        proxy_connect_timeout 3s;
        proxy_send_timeout 20s;
        proxy_read_timeout 30s;
        proxy_pass http://127.0.0.1:8090;
    }

    location = /api/v1/machine/source-health {
        # Health envelopes contain only bounded status metadata. Keep this much
        # smaller than autofill so accidental diagnostics cannot become uploads.
        client_max_body_size 64k;
        client_body_timeout 10s;
        limit_req zone=enterprise_agent_machine burst=30 nodelay;
        limit_req_status 429;
        limit_conn enterprise_agent_machine_conn 4;
        limit_conn_status 429;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 15s;
        proxy_pass http://127.0.0.1:8090;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
    }
}

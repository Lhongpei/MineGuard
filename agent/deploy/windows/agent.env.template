# MineGuard Enterprise Agent instance configuration.
# UTF-8 KEY=VALUE only. This file is parsed as data and is never executed.
# Keep one physical line per value. Inherited process variables take precedence.

ENTERPRISE_AGENT_DB=__DATABASE_PATH__
ENTERPRISE_AGENT_HOST=127.0.0.1
ENTERPRISE_AGENT_PORT=__PORT__
ENTERPRISE_AGENT_SESSION_TTL_SECONDS=28800
ENTERPRISE_AGENT_ALLOW_ANONYMOUS_LOCAL=false
ENTERPRISE_AGENT_SECURE_COOKIE=false
ENTERPRISE_AGENT_PUBLIC_ORIGIN=

# Generate a password hash with enterprise-agent hash-password. Never put a
# plaintext password here. An empty value enables only the loopback demo login.
ENTERPRISE_AGENT_USERS_JSON=

ENTERPRISE_MINE_ID=__MINE_ID__
ENTERPRISE_MINE_NAME=__MINE_NAME__
ENTERPRISE_OPERATOR_ID=__OPERATOR_ID__
ENTERPRISE_OPERATOR_NAME=__OPERATOR_NAME__
ENTERPRISE_SYSTEM_ID=__SYSTEM_ID__
ENTERPRISE_REPORTING_TIMEZONE=Asia/Shanghai
ENTERPRISE_CAPACITY_BAND=unclassified
ENTERPRISE_MINING_METHOD=underground
ENTERPRISE_SHIFT_SYSTEM=three-shift-eight-hour
ENTERPRISE_COAL_TYPE=unclassified
ENTERPRISE_OPERATING_REGIME=normal-production

# Windows uses semicolons between multiple directories.
ENTERPRISE_FIVE_QUANTITY_WATCH_DIRS=__WATCH_DIRECTORIES__
ENTERPRISE_FIVE_QUANTITY_POLL_SECONDS=5
ENTERPRISE_FIVE_QUANTITY_STABLE_SECONDS=2

# Leave PLATFORM_V2_BASE_URL empty until this mine has been registered by the
# regulator. Application and transport HMAC secrets must be different and at
# least 32 bytes. Inject real values only into this ACL-protected file or via a
# service-level secret manager; never place them in WinSW XML or arguments.
PLATFORM_V2_BASE_URL=
PLATFORM_V2_SENDER_ID=__SYSTEM_ID__
PLATFORM_V2_TIMEOUT_SECONDS=20
REGULATORY_SYSTEM_ID=mineguard-qinyuan
REGULATORY_PARTY_ID=regulator-qinyuan
ENTERPRISE_EXCHANGE_KEY_ID=not-configured-enterprise-key
REGULATORY_EXCHANGE_KEY_ID=not-configured-regulator-key
ENTERPRISE_EXCHANGE_HMAC_SECRET=
PLATFORM_V2_TRANSPORT_HMAC_SECRET=
PLATFORM_V2_CA_BUNDLE=

# Optional LLM and coal-news capabilities. Core import and reporting work
# without these settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
COAL_NEWS_SEARCH_ENABLED=true
COAL_NEWS_BAIDU_ENABLED=true
COAL_NEWS_DEEPSEEK_WEB_SEARCH_ENABLED=true

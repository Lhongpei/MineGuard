<service>
  <id>__SERVICE_ID__</id>
  <name>__SERVICE_NAME__</name>
  <description>MineGuard enterprise reporting agent instance __INSTANCE_NAME__</description>
  <executable>__EXECUTABLE__</executable>
  <arguments>--env-file &quot;__ENV_FILE__&quot; --authoritative-env-file serve</arguments>
  <workingdirectory>__WORKING_DIRECTORY__</workingdirectory>
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONUNBUFFERED" value="1" />
  <env name="MINEGUARD_SERVICE_PRODUCTION_MODE" value="__PRODUCTION_MODE__" />
  <env name="MINEGUARD_SERVICE_FOUR_EYES_REQUIRED" value="__FOUR_EYES_REQUIRED__" />
  <serviceaccount>
    <username>__SERVICE_ACCOUNT__</username>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>__LOG_DIRECTORY__</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>14</keepFiles>
  </log>
</service>

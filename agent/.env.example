# 煤矿五量企业智能体：一个实例只绑定一个煤矿。
ENTERPRISE_AGENT_DB=./data/enterprise-agent.db
ENTERPRISE_AGENT_HOST=127.0.0.1
ENTERPRISE_AGENT_PORT=8090
ENTERPRISE_AGENT_SESSION_TTL_SECONDS=28800
ENTERPRISE_AGENT_ALLOW_ANONYMOUS_LOCAL=false
ENTERPRISE_AGENT_SECURE_COOKIE=false
ENTERPRISE_AGENT_PRODUCTION_MODE=false
ENTERPRISE_AGENT_FOUR_EYES_REQUIRED=false
# ENTERPRISE_AGENT_PUBLIC_ORIGIN=https://report.enterprise.example

# 正式环境分别为两人运行 `enterprise-agent hash-password --production --json`，
# 再通过密钥系统注入单行 JSON，并把上面两个模式开关都设为 true。
# 未配置时，本机回环演示账号是 demo / 123123123，只能查看和编辑，不能确认报送。
# ENTERPRISE_AGENT_USERS_JSON=[{"actor_id":"preparer-001","name":"张三","role":"企业经办人","password_hash":"paste-first-production-hash","permissions":["read","write"],"must_change_password":false,"credential_provenance":"production_hash_command"},{"actor_id":"reviewer-001","name":"李四","role":"企业复核负责人","password_hash":"paste-second-production-hash","permissions":["read","confirm","submit"],"must_change_password":false,"credential_provenance":"production_hash_command"}]

# 固定煤矿、经营主体与企业智能体身份；页面不能切换到另一煤矿。
ENTERPRISE_MINE_ID=MINE-QY-001
ENTERPRISE_MINE_NAME=示例一号煤矿
ENTERPRISE_OPERATOR_ID=operator-qy-001
ENTERPRISE_OPERATOR_NAME=示例一号煤业有限公司
ENTERPRISE_SYSTEM_ID=agent-mine-qy-001
ENTERPRISE_REPORTING_TIMEZONE=Asia/Shanghai

# 政府登记的匿名同类矿分组维度。
ENTERPRISE_CAPACITY_BAND=medium
ENTERPRISE_MINING_METHOD=underground
ENTERPRISE_SHIFT_SYSTEM=three-shift-eight-hour
ENTERPRISE_COAL_TYPE=bituminous
ENTERPRISE_OPERATING_REGIME=normal-production

# 可选固定目录，以系统路径分隔符分开。Linux 使用冒号，Windows 使用分号。
# 人工上传和直采并列合法，只记录来源方式。
# ENTERPRISE_FIVE_QUANTITY_WATCH_DIRS=/data/mine/five-quantity-inbox
ENTERPRISE_FIVE_QUANTITY_POLL_SECONDS=5
ENTERPRISE_FIVE_QUANTITY_STABLE_SECONDS=2

# 可选的机器连接器入口。它只允许形成/更新“待复核”的五量草稿，不能确认或报送。
# one-mine 实例最多配置一个权威 client，多来源由 connector-service 聚合；
# allowed_sources 精确绑定来源系统、是否必需和时效阈值，不允许通配。正式环境使用策略对象，
# 并与 connector TOML 的 required_sources/max_staleness_seconds 完全一致；真实密钥不写前端。
# ENTERPRISE_AGENT_CONNECTOR_CLIENTS_JSON=[{"client_id":"mine-qy-001-connector","secret":"replace-with-a-different-random-secret-at-least-32-bytes","permissions":["autofill"],"allowed_sources":{"blasting-file":{"source_system":"blasting-ledger","required":true,"freshness_max_seconds":3600},"production-http":{"source_system":"production-mes","required":true,"freshness_max_seconds":3600},"energy-sqlite":{"source_system":"energy-sqlite","required":true,"freshness_max_seconds":3600}}}]
ENTERPRISE_AGENT_CONNECTOR_MAX_CLOCK_SKEW_SECONDS=300

# Agent ↔ Platform 五量交换 V2。只有显式配置 PLATFORM_V2_BASE_URL 才启用。
PLATFORM_V2_BASE_URL=http://127.0.0.1:8080
PLATFORM_V2_SENDER_ID=agent-mine-qy-001
PLATFORM_V2_TIMEOUT_SECONDS=20
REGULATORY_SYSTEM_ID=mineguard-qinyuan
REGULATORY_PARTY_ID=regulator-qinyuan
ENTERPRISE_EXCHANGE_KEY_ID=enterprise-key-v2
REGULATORY_EXCHANGE_KEY_ID=regulator-key-v2

# 两把密钥都至少 32 字节，生产必须来自密钥系统；二者使用不同 HMAC 签名域。
ENTERPRISE_EXCHANGE_HMAC_SECRET=replace-with-message-hmac-secret-at-least-32-bytes
PLATFORM_V2_TRANSPORT_HMAC_SECRET=replace-with-transport-hmac-secret-at-least-32-bytes

# 企业应用签名密钥轮换后，将退役 key ID/secret 只放入历史验签密钥环；
# 新消息始终使用上面的当前 key。JSON 必须保持单行，历史项不得与当前项复用。
# ENTERPRISE_HISTORICAL_EXCHANGE_KEYS_JSON=[{"key_id":"enterprise-key-v1","secret":"replace-with-retired-enterprise-message-secret"}]

# 政府应用签名密钥轮换时可暂时保留上一把；两项必须同时设置。
# REGULATORY_PREVIOUS_EXCHANGE_KEY_ID=regulator-key-v1
# REGULATORY_PREVIOUS_EXCHANGE_HMAC_SECRET=replace-with-previous-message-secret

# 私有 CA 部署可指定普通 PEM 文件；远程监管地址必须是 HTTPS，客户端拒绝重定向。
# PLATFORM_V2_CA_BUNDLE=/etc/enterprise-agent/regulatory-ca.pem

# 模型能力可选；十量导入、报送、验签和风险工具不依赖模型。
# 正式环境不得把 API Key、BASE_URL、模型或重试参数写入普通 env，也不得通过
# MINEGUARD_AGENT_MODEL_TRUST_STORE 替换发行版固定的签发信任库。
# 导入企业专属 .mgllm 后，只同时启用以下两个非秘密绝对路径指针：
# MINEGUARD_AGENT_MODEL_CREDENTIAL_LOCK_FILE=/var/lib/enterprise-agent/model-credential-lock.json
# MINEGUARD_AGENT_MODEL_CREDENTIAL_SECRET_STORE=/var/lib/enterprise-agent/model-credential-secret.json
# 本地开发临时使用的 MINEGUARD_AGENT_API_KEY/MINEGUARD_AGENT_BASE_URL/
# MINEGUARD_AGENT_MODEL 及旧 DEEPSEEK_* 变量会被正式配置检查拒绝。
# 签发、双通道交付、Windows GUI 和 Linux CLI 见：
# ../docs/企业模型凭据签发与轮换.md

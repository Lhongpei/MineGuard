# Enterprise Agent local service
ENTERPRISE_AGENT_DB=./data/enterprise-agent.db
ENTERPRISE_AGENT_HOST=127.0.0.1
ENTERPRISE_AGENT_PORT=8090
# Generate hashes with: enterprise-agent hash-password
# Store this JSON in a secret manager in production; never configure plaintext passwords.
# ENTERPRISE_AGENT_USERS_JSON=[{"actor_id":"operator-001","name":"张三","role":"企业管理员","password_hash":"paste-generated-hash-here","permissions":["read","write","confirm","submit","governance_review","skill_admin"],"must_change_password":false}]
ENTERPRISE_AGENT_SESSION_TTL_SECONDS=28800
# Development escape hatch. Accepted only while listening on a loopback address.
ENTERPRISE_AGENT_ALLOW_ANONYMOUS_LOCAL=false
# Required for non-loopback listening behind an HTTPS reverse proxy.
ENTERPRISE_AGENT_SECURE_COOKIE=false
# Recommended when a reverse proxy forwards to a loopback-bound agent.
# Must be one exact origin with no path. Production must use HTTPS:
# ENTERPRISE_AGENT_PUBLIC_ORIGIN=https://report.enterprise.example

# Durable read-only Agent V2 workflows and scheduler.
AGENT_V2_ENABLED=true
AGENT_V2_SCHEDULER_ENABLED=true
AGENT_V2_SCHEDULER_POLL_SECONDS=5
AGENT_V2_WORKER_COUNT=2
AGENT_V2_SPECIALIST_WORKER_COUNT=4
AGENT_V2_FLOW_LEASE_SECONDS=120

# Platform contract/transport (the agent does not import platform code)
PLATFORM_BASE_URL=http://127.0.0.1:8080
PLATFORM_SUBMISSION_PATH=/v1/enterprise-submissions
PLATFORM_CAPABILITIES_PATH=/v1/enterprise-submission-capabilities
PLATFORM_CLIENT_ID=replace-with-platform-issued-client-id
PLATFORM_TRANSPORT_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Optional only when the regulator explicitly issues a second bearer factor:
# PLATFORM_BEARER_TOKEN=replace-with-platform-issued-token

# Optional OpenAI-compatible extraction assistant. Rule mode works without it.
# DEEPSEEK_API_KEY=inject-through-secret-manager
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2

# Install as /etc/mineguard/mineguard.env, owner root:mineguard, mode 0640.
# Keep JSON on one physical line and inject real secrets from an approved
# secret manager.  The password is read only while an empty auth.db is bootstrapped.
MINEGUARD_ADMIN_PASSWORD=replace-with-long-random-password

MINEGUARD_V2_PLATFORM_SYSTEM_ID=mineguard-qinyuan
MINEGUARD_V2_PLATFORM_PARTY_ID=regulator-qinyuan
MINEGUARD_V2_PLATFORM_KEY_ID=regulator-key-v2

# One entry per independently owned mine and Agent instance.  message_keys
# verify enterprise application messages; transport_secrets authenticate HTTP.
# The two secrets must be explicit, at least 32 bytes, and different.
# During rotation retain an old named message key or append one old transport
# secret only for the approved overlap window.
MINEGUARD_V2_CLIENTS_JSON='{"clients":[{"sender_id":"replace-agent-system-id","party_id":"replace-independent-operator-id","mine_id":"replace-mine-id","mine_name":"replace-mine-name","comparison_context":{"capacity_band":"replace-governed-band","mining_method":"replace-governed-method","shift_system":"three-shift-eight-hour","coal_type":"replace-governed-coal-type","operating_regime":"normal-production"},"active_message_key_id":"replace-enterprise-key-id","message_keys":{"replace-enterprise-key-id":"replace-message-secret-at-least-32-bytes"},"transport_secrets":["replace-different-transport-secret-at-least-32-bytes"]}]}'

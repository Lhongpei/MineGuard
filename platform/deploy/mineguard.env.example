# 仅首次初始化空的 auth.db 时使用；创建管理员后从文件中删除此行。
MINEGUARD_ADMIN_PASSWORD=replace-with-a-long-random-password

# 企业智能体机器接入客户端注册表。JSON 必须保持单行；每个运输密钥至少
# 32 字节。第一项为当前密钥，短暂轮换期可在后续项放上一把密钥。
# authorized_confirmers 和 verified_event_snapshots 仅用于旧部署启动迁移；
# 新确认人版本与事件结果分别走监管管理员 API /v1/admin/external-confirmers 和
# /v1/admin/external-event-snapshots，企业端不能自证。
# 此值只属于监管端，不要把企业端来源密钥或模型 API Key 放在这里。
MINEGUARD_EXTERNAL_CLIENTS_JSON='[{"client_id":"replace-with-client-id","enterprise_id":"replace-with-enterprise-id","mine_ids":["replace-with-mine-id"],"secrets":["replace-with-at-least-32-random-bytes"]}]'

# 矿端边缘采集客户端。这里的 secrets 是随机密钥原始字节的标准 Base64，
# 不是可直接阅读的口令；第一项为当前密钥，后续项只用于短期轮换验签。
# 矿端 MINE_EDGE_UPSTREAM_HMAC_SECRET_BASE64 必须配置为完全相同的 Base64。
MINEGUARD_EDGE_CLIENTS_JSON='[{"client_id":"replace-with-edge-client-id","mine_ids":["replace-with-mine-id"],"secrets":["cmVwbGFjZS13aXRoLTMyLWJ5dGUtb3ItbG9uZ2VyLXJhbmRvbS1rZXk="]}]'

# 平台独立安全复算的持久重试队列。失败按 5、10、20……秒指数退避，
# 单批默认最多 5 次后进入死信并保持失败预警，管理员可受控手工重算。
MINEGUARD_EDGE_EVALUATION_MAX_ATTEMPTS=5
MINEGUARD_EDGE_EVALUATION_BASE_RETRY_SECONDS=5
MINEGUARD_EDGE_EVALUATION_MAX_RETRY_SECONDS=300
MINEGUARD_EDGE_EVALUATION_POLL_SECONDS=1
MINEGUARD_EDGE_EVALUATION_LEASE_SECONDS=120

# 责任路由后台检查主责已读超时并按已配置路由升级至备岗。
MINEGUARD_RESPONSIBILITY_POLL_SECONDS=5

# 可选：部署方提供的辖区 Polygon/MultiPolygon GeoJSON。平台启动时会校验
# 文件大小、坐标范围、闭合环和点数并剥离非必要属性。未配置时页面明确显示
# 非测绘相对位置示意；配置文件的来源、坐标系和精度仍须现场验收。
# MINEGUARD_MAP_GEOJSON_PATH=/etc/mineguard/qinyuan-boundary.geojson

# 可选：将站内安全预警通过签名 webhook 推送给政务消息网关/值班系统。
# 生产 URL 必须为 HTTPS；仅回环联调允许 HTTP。secret_base64 也至少 32 随机字节。
# minimum_level 可为 blue/yellow/orange/red。未配置时站内预警和 outbox 仍正常。
MINEGUARD_SAFETY_WEBHOOKS_JSON='[]'

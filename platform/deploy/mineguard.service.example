[Unit]
Description=MineGuard government ten-quantity V3 regulatory service
After=network.target

[Service]
Type=simple
User=mineguard
Group=mineguard
WorkingDirectory=/opt/mineguard
EnvironmentFile=-/etc/mineguard/mineguard.env
ExecStart=/opt/mineguard/.venv/bin/mineguard serve --production --host 127.0.0.1 --port 8080 --state-directory /var/lib/mineguard --secure-cookie
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mineguard
ReadOnlyPaths=/etc/mineguard
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

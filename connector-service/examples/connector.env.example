# Generate an independent random value of at least 32 bytes. The same value is
# configured in the Agent allowlist; never commit the real value.
ENTERPRISE_CONNECTOR_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Agent-side example (put in the Agent environment, not this service):
# ENTERPRISE_AGENT_CONNECTOR_CLIENTS_JSON=[{"client_id":"mine-qy-001-connector","secret":"replace-with-at-least-32-random-bytes","permissions":["autofill"],"allowed_sources":{"blasting-file":{"source_system":"blasting-ledger","required":true,"freshness_max_seconds":3600},"production-http":{"source_system":"production-mes","required":true,"freshness_max_seconds":3600},"energy-sqlite":{"source_system":"energy-sqlite","required":true,"freshness_max_seconds":3600},"business-sqlite":{"source_system":"business-sqlite","required":true,"freshness_max_seconds":3600}}}]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineguard:contract:platform-client-registration-payload:v1",
  "title": "Platform Client Registration Plaintext Payload V1",
  "description": "Plaintext after authenticated decryption of the Platform half of a paired provisioning bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "bundle_id",
    "pair_id",
    "profile_version",
    "client",
    "platform_identity"
  ],
  "properties": {
    "kind": {
      "const": "platform-client-registration"
    },
    "bundle_id": {
      "type": "string",
      "format": "uuid"
    },
    "pair_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "client": {
      "$ref": "#/$defs/client"
    },
    "platform_identity": {
      "$ref": "#/$defs/platformIdentity"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "secret": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sender_id",
        "party_id",
        "mine_id",
        "mine_name",
        "comparison_context",
        "active_message_key_id",
        "message_keys",
        "transport_secrets"
      ],
      "properties": {
        "sender_id": {
          "$ref": "#/$defs/identifier"
        },
        "party_id": {
          "$ref": "#/$defs/identifier"
        },
        "mine_id": {
          "$ref": "#/$defs/identifier"
        },
        "mine_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "comparison_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity_band",
            "mining_method",
            "shift_system",
            "coal_type",
            "operating_regime"
          ],
          "properties": {
            "capacity_band": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            },
            "mining_method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            },
            "shift_system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            },
            "coal_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            },
            "operating_regime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            }
          }
        },
        "active_message_key_id": {
          "$ref": "#/$defs/identifier"
        },
        "message_keys": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 2,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/secret"
          }
        },
        "transport_secrets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/secret"
          }
        }
      }
    },
    "platformIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "party_id",
        "key_id"
      ],
      "properties": {
        "system_id": {
          "$ref": "#/$defs/identifier"
        },
        "party_id": {
          "$ref": "#/$defs/identifier"
        },
        "key_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineguard:contract:provisioning-bundle:v1",
  "title": "MineGuard Provisioning Bundle V1",
  "description": "Signed and activation-code-encrypted provisioning envelope. The decrypted payload is validated by the bundle-kind-specific payload schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protected",
    "ciphertext",
    "signature"
  ],
  "properties": {
    "protected": {
      "$ref": "#/$defs/protectedHeader"
    },
    "ciphertext": {
      "description": "AES-256-GCM ciphertext with the 16-byte authentication tag appended, encoded as base64url without padding.",
      "type": "string",
      "minLength": 23,
      "maxLength": 5592406,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "signature": {
      "description": "64-byte Ed25519 signature encoded as base64url without padding.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockedKey": {
      "type": "string",
      "enum": [
        "ENTERPRISE_AGENT_FOUR_EYES_REQUIRED",
        "ENTERPRISE_AGENT_PRODUCTION_MODE",
        "ENTERPRISE_AGENT_PUBLIC_ORIGIN",
        "ENTERPRISE_AGENT_SECURE_COOKIE",
        "ENTERPRISE_CAPACITY_BAND",
        "ENTERPRISE_COAL_TYPE",
        "ENTERPRISE_EXCHANGE_HMAC_SECRET",
        "ENTERPRISE_EXCHANGE_KEY_ID",
        "ENTERPRISE_HISTORICAL_EXCHANGE_KEYS_JSON",
        "ENTERPRISE_MINE_ID",
        "ENTERPRISE_MINE_NAME",
        "ENTERPRISE_MINING_METHOD",
        "ENTERPRISE_OPERATING_REGIME",
        "ENTERPRISE_OPERATOR_ID",
        "ENTERPRISE_OPERATOR_NAME",
        "ENTERPRISE_REPORTING_TIMEZONE",
        "ENTERPRISE_SHIFT_SYSTEM",
        "ENTERPRISE_SYSTEM_ID",
        "PLATFORM_V3_BASE_URL",
        "PLATFORM_V3_CA_BUNDLE",
        "PLATFORM_V3_SENDER_ID",
        "PLATFORM_V3_TRANSPORT_HMAC_SECRET",
        "REGULATORY_PARTY_ID",
        "REGULATORY_PREVIOUS_EXCHANGE_HMAC_SECRET",
        "REGULATORY_PREVIOUS_EXCHANGE_KEY_ID",
        "REGULATORY_SYSTEM_ID",
        "REGULATORY_EXCHANGE_KEY_ID"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mine_id",
        "system_id",
        "party_id"
      ],
      "properties": {
        "mine_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "system_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "party_id": {
          "$ref": "#/$defs/safeIdentifier"
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "kdf",
        "salt",
        "n",
        "r",
        "p",
        "nonce"
      ],
      "properties": {
        "algorithm": {
          "const": "aes-256-gcm"
        },
        "kdf": {
          "const": "scrypt"
        },
        "salt": {
          "description": "Exactly 16 random bytes, base64url without padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
        },
        "n": {
          "const": 16384
        },
        "r": {
          "const": 8
        },
        "p": {
          "const": 1
        },
        "nonce": {
          "description": "Exactly 12 random bytes, base64url without padding; it may never repeat for the same derived AES key.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16}$"
        }
      }
    },
    "protectedHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "bundle_kind",
        "bundle_id",
        "pair_id",
        "profile_version",
        "issued_at",
        "expires_at",
        "issuer_id",
        "issuer_key_id",
        "subject",
        "payload_sha256",
        "locked_config_sha256",
        "locked_keys",
        "encryption"
      ],
      "properties": {
        "contract_version": {
          "const": "mineguard-provisioning-bundle-v1"
        },
        "bundle_kind": {
          "type": "string",
          "enum": [
            "enterprise-agent-provisioning",
            "platform-client-registration"
          ]
        },
        "bundle_id": {
          "type": "string",
          "format": "uuid"
        },
        "pair_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "issued_at": {
          "$ref": "#/$defs/utcDateTime"
        },
        "expires_at": {
          "$ref": "#/$defs/utcDateTime"
        },
        "issuer_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "issuer_key_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locked_keys": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/lockedKey"
          }
        },
        "encryption": {
          "$ref": "#/$defs/encryption"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bundle_kind": {
                "const": "enterprise-agent-provisioning"
              }
            },
            "required": [
              "bundle_kind"
            ]
          },
          "then": {
            "properties": {
              "locked_keys": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "locked_keys": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineguard:contract:model-credential-profile:v1",
  "title": "MineGuard Model Credential Signing Profile V1",
  "description": "Non-secret issuer input used with a separately supplied provider API key to create one enterprise-bound .mgllm bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "credential_version",
    "subject",
    "provider",
    "install_before",
    "runtime_not_after",
    "issuer_id",
    "issuer_key_id",
    "issuer_key_epoch"
  ],
  "properties": {
    "credential_id": {
      "$ref": "#/$defs/uuidV4"
    },
    "credential_version": {
      "$ref": "#/$defs/credentialVersion"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "install_before": {
      "$ref": "#/$defs/utcSecond"
    },
    "runtime_not_after": {
      "$ref": "#/$defs/utcSecond"
    },
    "issuer_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "issuer_key_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "credentialVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "utcSecond": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mine_id",
        "system_id",
        "party_id",
        "pair_id"
      ],
      "properties": {
        "mine_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "system_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "party_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "pair_id": {
          "$ref": "#/$defs/uuidV4"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "protocol",
        "base_url",
        "model",
        "capabilities",
        "timeout_seconds",
        "max_retries"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "protocol": {
          "const": "openai-compatible-chat-completions"
        },
        "base_url": {
          "description": "Canonical HTTPS base URL with an optional path prefix; userinfo, query, fragment, percent encoding, duplicate slashes, dot segments, and a trailing slash are forbidden.",
          "type": "string",
          "format": "uri",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://[^/?#@%\\s]+(?:/[A-Za-z0-9._~!$&'()*+,;=:@-]+(?:/[A-Za-z0-9._~!$&'()*+,;=:@-]+)*)?$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "capabilities": {
          "description": "Lexicographically sorted, unique and non-empty capability allowlist.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "chat",
              "coal-news-search",
              "extraction"
            ]
          },
          "oneOf": [
            {"const": ["chat"]},
            {"const": ["coal-news-search"]},
            {"const": ["extraction"]},
            {"const": ["chat", "coal-news-search"]},
            {"const": ["chat", "extraction"]},
            {"const": ["coal-news-search", "extraction"]},
            {"const": ["chat", "coal-news-search", "extraction"]}
          ]
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  }
}

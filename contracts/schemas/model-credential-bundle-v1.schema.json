{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineguard:contract:model-credential-bundle:v1",
  "title": "MineGuard Enterprise Model Credential Bundle V1",
  "description": "Signed, activation-code-encrypted .mgllm envelope for one enterprise Agent. This bundle is never imported by the regulatory Platform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protected",
    "ciphertext",
    "signature"
  ],
  "properties": {
    "protected": {
      "$ref": "#/$defs/protectedHeader"
    },
    "ciphertext": {
      "description": "AES-256-GCM ciphertext followed by its 16-byte authentication tag, encoded as base64url without padding. The decoded value must contain at least one plaintext byte.",
      "type": "string",
      "minLength": 23,
      "maxLength": 1398123,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "signature": {
      "description": "64-byte Ed25519 signature encoded as base64url without padding.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "credentialVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "utcSecond": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mine_id",
        "system_id",
        "party_id",
        "pair_id"
      ],
      "properties": {
        "mine_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "system_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "party_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "pair_id": {
          "$ref": "#/$defs/uuidV4"
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "kdf",
        "salt",
        "n",
        "r",
        "p",
        "nonce"
      ],
      "properties": {
        "algorithm": {
          "const": "aes-256-gcm"
        },
        "kdf": {
          "const": "scrypt"
        },
        "salt": {
          "description": "Exactly 16 random bytes, encoded as base64url without padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
        },
        "n": {
          "const": 16384
        },
        "r": {
          "const": 8
        },
        "p": {
          "const": 1
        },
        "nonce": {
          "description": "Exactly 12 random bytes, encoded as base64url without padding; it must never repeat for the same derived AES key.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16}$"
        }
      }
    },
    "protectedHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "bundle_kind",
        "bundle_id",
        "credential_id",
        "credential_version",
        "issued_at",
        "install_before",
        "runtime_not_after",
        "issuer_id",
        "issuer_key_id",
        "issuer_key_epoch",
        "subject",
        "payload_sha256",
        "provider_config_sha256",
        "encryption"
      ],
      "properties": {
        "contract_version": {
          "const": "mineguard-model-credential-bundle-v1"
        },
        "bundle_kind": {
          "const": "enterprise-agent-model-credential"
        },
        "bundle_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "credential_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "credential_version": {
          "$ref": "#/$defs/credentialVersion"
        },
        "issued_at": {
          "$ref": "#/$defs/utcSecond"
        },
        "install_before": {
          "$ref": "#/$defs/utcSecond"
        },
        "runtime_not_after": {
          "$ref": "#/$defs/utcSecond"
        },
        "issuer_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "issuer_key_id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "issuer_key_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "encryption": {
          "$ref": "#/$defs/encryption"
        }
      }
    }
  }
}

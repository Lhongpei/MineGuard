{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineguard:contract:error:v1",
  "title": "Enterprise Submission Error V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "error_id",
    "occurred_at",
    "http_status",
    "code",
    "message",
    "retryable",
    "violations"
  ],
  "properties": {
    "contract_version": {
      "const": "enterprise-submission-error-v1"
    },
    "error_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "http_status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "retryable": {
      "type": "boolean"
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "server_time": {
      "type": "string",
      "format": "date-time",
      "description": "Included for timestamp-skew errors."
    },
    "violations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "json_pointer",
          "rule",
          "message"
        ],
        "properties": {
          "json_pointer": {
            "type": "string",
            "pattern": "^(/.*)?$"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}

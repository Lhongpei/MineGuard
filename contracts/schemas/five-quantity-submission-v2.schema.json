{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineguard:contract:five-quantity-submission:v2",
  "title": "Five-Quantity Submission V2",
  "description": "One mine's human-confirmed daily and shift report for the five business groups airflow, electricity, blasting materials, mine-entry personnel and production. Blasting materials retain detonator count and explosive mass as separate atomic measurements. Manual and direct acquisition are parallel valid sources and carry no trust rank.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "message_type",
    "message_id",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "revision",
    "predecessor",
    "created_at",
    "sender",
    "recipient",
    "mine_id",
    "payload",
    "signature_envelope"
  ],
  "properties": {
    "contract_version": {
      "const": "five-quantity-submission-v2"
    },
    "message_type": {
      "const": "five_quantity_submission"
    },
    "message_id": {
      "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/uuid"
    },
    "correlation_id": {
      "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/uuid"
    },
    "causation_id": {
      "anyOf": [
        {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/safePositiveInteger"
    },
    "predecessor": {
      "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/predecessor"
    },
    "created_at": {
      "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/dateTime"
    },
    "sender": {
      "allOf": [
        {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/participant"
        },
        {
          "properties": {
            "role": {
              "const": "enterprise_agent"
            }
          }
        }
      ]
    },
    "recipient": {
      "allOf": [
        {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/participant"
        },
        {
          "properties": {
            "role": {
              "const": "regulatory_platform"
            }
          }
        }
      ]
    },
    "mine_id": {
      "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/identifier"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "signature_envelope": {
      "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/signatureEnvelope"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "predecessor": {
            "type": "null"
          },
          "causation_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "predecessor": {
            "type": "object"
          },
          "causation_id": {
            "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/uuid"
          }
        }
      }
    }
  ],
  "$defs": {
    "shift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shift_code",
        "start_at",
        "end_at",
        "measurements"
      ],
      "properties": {
        "shift_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "start_at": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/dateTime"
        },
        "end_at": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/dateTime"
        },
        "measurements": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/measurementSet"
        }
      }
    },
    "reportedQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daily_total",
        "shifts"
      ],
      "properties": {
        "daily_total": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/measurementSet"
        },
        "shifts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zero_shift",
            "eight_shift",
            "four_shift"
          ],
          "properties": {
            "zero_shift": {
              "$ref": "#/$defs/shift"
            },
            "eight_shift": {
              "$ref": "#/$defs/shift"
            },
            "four_shift": {
              "$ref": "#/$defs/shift"
            }
          }
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "operating_state",
        "reported_quantity"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "operating_state": {
          "type": "string",
          "enum": [
            "producing",
            "stopped",
            "maintenance",
            "restarting",
            "unknown"
          ]
        },
        "reported_quantity": {
          "$ref": "#/$defs/reportedQuantity"
        }
      }
    },
    "comparisonContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_band",
        "mining_method",
        "shift_system",
        "coal_type",
        "operating_regime"
      ],
      "properties": {
        "capacity_band": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mining_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "shift_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "coal_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "operating_regime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "Values are checked against the regulator's mine registry and used only to derive an anonymous comparable-mine group."
    },
    "agentProcessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_performed",
        "model_assistance_used",
        "processing_record_sha256"
      ],
      "properties": {
        "normalization_performed": {
          "type": "boolean"
        },
        "model_assistance_used": {
          "type": "boolean"
        },
        "processing_record_sha256": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/sha256"
        },
        "model_output_sha256": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model_assistance_used": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "model_output_sha256"
            ]
          },
          "else": {
            "not": {
              "required": [
                "model_output_sha256"
              ]
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mine",
        "reporting_month",
        "timezone",
        "period_start",
        "period_end",
        "closed_at",
        "comparison_context",
        "days",
        "sources",
        "agent_processing",
        "human_confirmation"
      ],
      "properties": {
        "mine": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/mine"
        },
        "reporting_month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:UTC|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]|[A-Za-z][A-Za-z0-9._+-]*(?:/[A-Za-z0-9._+-]+)+)$"
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "closed_at": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/dateTime"
        },
        "comparison_context": {
          "$ref": "#/$defs/comparisonContext"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 366,
          "items": {
            "$ref": "#/$defs/day"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/source"
          }
        },
        "agent_processing": {
          "$ref": "#/$defs/agentProcessing"
        },
        "human_confirmation": {
          "$ref": "urn:mineguard:contract:exchange-common:v2#/$defs/humanConfirmation"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mineguard:contract:exchange-common:v2",
  "title": "MineGuard Five-Quantity Exchange Common Definitions V2",
  "description": "Neutral definitions shared by the six V2 exchange messages. Five business quantities are represented by six atomic measurements because blasting materials retain detonator count and explosive mass separately. This artifact contains data types only and is not runtime code for either product.",
  "x-five-quantity-groups": {
    "airflow": [
      "ventilation_m3_min"
    ],
    "electricity": [
      "electricity_kwh"
    ],
    "blasting_materials": [
      "detonators_count",
      "explosives_kg"
    ],
    "mine_entry_personnel": [
      "mine_entry_persons"
    ],
    "production": [
      "production_t"
    ]
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "party_id",
        "role"
      ],
      "properties": {
        "system_id": {
          "$ref": "#/$defs/identifier"
        },
        "party_id": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "type": "string",
          "enum": [
            "enterprise_agent",
            "regulatory_platform"
          ]
        }
      }
    },
    "predecessor": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "message_id",
        "payload_sha256"
      ],
      "properties": {
        "message_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "description": "Null for revision 1. Later revisions must point to the immediately preceding immutable message and payload digest."
    },
    "signatureEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "key_id",
        "signed_at",
        "nonce",
        "payload_sha256",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "hmac-sha256-v2"
        },
        "canonicalization": {
          "const": "rfc8785-jcs"
        },
        "key_id": {
          "$ref": "#/$defs/identifier"
        },
        "signed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "nonce": {
          "type": "string",
          "minLength": 22,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of RFC 8785 canonical bytes of payload only."
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mine_id",
        "mine_name",
        "operator_id",
        "operator_name"
      ],
      "properties": {
        "mine_id": {
          "$ref": "#/$defs/identifier"
        },
        "mine_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operator_id": {
          "$ref": "#/$defs/identifier"
        },
        "operator_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unified_social_credit_code": {
          "type": "string",
          "pattern": "^[0-9A-HJ-NPQRTUWXY]{18}$"
        }
      },
      "description": "Exactly one mine and its independent operator. A V2 message never contains multiple mines."
    },
    "qualityFlag": {
      "type": "string",
      "enum": [
        "reported",
        "missing",
        "unavailable",
        "not_applicable",
        "partial",
        "unit_converted",
        "corrected",
        "source_format_warning"
      ]
    },
    "metricCode": {
      "type": "string",
      "enum": [
        "ventilation_m3_min",
        "mine_entry_persons",
        "electricity_kwh",
        "detonators_count",
        "explosives_kg",
        "production_t"
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_code",
        "value",
        "unit",
        "aggregation",
        "quality_flags",
        "source_refs"
      ],
      "properties": {
        "metric_code": {
          "$ref": "#/$defs/metricCode"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "unit": {
          "type": "string",
          "enum": [
            "m3/min",
            "person",
            "kWh",
            "count",
            "kg",
            "t"
          ]
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "time_weighted_average",
            "sum",
            "snapshot"
          ]
        },
        "quality_flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/qualityFlag"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "quality_flags": {
                "contains": {
                  "enum": [
                    "missing",
                    "unavailable",
                    "not_applicable"
                  ]
                },
                "minContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "quality_flags": {
                "not": {
                  "contains": {
                    "enum": [
                      "missing",
                      "unavailable",
                      "not_applicable"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "measurementSet": {
      "type": "object",
      "additionalProperties": false,
      "description": "Six atomic measurements implementing exactly five business groups: airflow, electricity, blasting_materials, mine_entry_personnel and production. detonators_count and explosives_kg belong to the single blasting_materials group but have unlike units and must never be arithmetically added into a unitless total.",
      "required": [
        "ventilation_m3_min",
        "mine_entry_persons",
        "electricity_kwh",
        "detonators_count",
        "explosives_kg",
        "production_t"
      ],
      "properties": {
        "ventilation_m3_min": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "metric_code": {
                  "const": "ventilation_m3_min"
                },
                "unit": {
                  "const": "m3/min"
                },
                "aggregation": {
                  "enum": [
                    "time_weighted_average",
                    "snapshot"
                  ]
                }
              }
            }
          ]
        },
        "mine_entry_persons": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "metric_code": {
                  "const": "mine_entry_persons"
                },
                "unit": {
                  "const": "person"
                },
                "aggregation": {
                  "const": "sum"
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          ],
          "description": "Count of mine-entry personnel in the reporting interval. It is an additive non-negative integer, not total employment and not a snapshot of people currently underground."
        },
        "electricity_kwh": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "metric_code": {
                  "const": "electricity_kwh"
                },
                "unit": {
                  "const": "kWh"
                },
                "aggregation": {
                  "const": "sum"
                }
              }
            }
          ]
        },
        "detonators_count": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "metric_code": {
                  "const": "detonators_count"
                },
                "unit": {
                  "const": "count"
                },
                "aggregation": {
                  "const": "sum"
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          ],
          "description": "Detonator count, an atomic component of the blasting_materials business group."
        },
        "explosives_kg": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "metric_code": {
                  "const": "explosives_kg"
                },
                "unit": {
                  "const": "kg"
                },
                "aggregation": {
                  "const": "sum"
                }
              }
            }
          ],
          "description": "Explosive mass in kilograms, an atomic component of the blasting_materials business group. It must not be added to detonator count."
        },
        "production_t": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "metric_code": {
                  "const": "production_t"
                },
                "unit": {
                  "const": "t"
                },
                "aggregation": {
                  "const": "sum"
                }
              }
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "acquisition_mode",
        "source_system",
        "source_record_id",
        "captured_at",
        "evidence_sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "acquisition_mode": {
          "type": "string",
          "enum": [
            "direct_collection",
            "manual_import"
          ],
          "description": "Trace metadata only. Direct and manual acquisition are equally valid and this field must not create a trust tier or algorithm weight."
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "captured_at": {
          "$ref": "#/$defs/dateTime"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "humanConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "confirmer_id",
        "confirmer_name",
        "role",
        "confirmed_at",
        "content_sha256"
      ],
      "properties": {
        "confirmed": {
          "const": true
        },
        "confirmer_id": {
          "$ref": "#/$defs/identifier"
        },
        "confirmer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "confirmed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the complete immutable confirmation record, not merely the displayed declaration."
        }
      }
    },
    "metricCodeList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/metricCode"
      }
    }
  }
}
